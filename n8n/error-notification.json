{
  "name": "Stage 2 - Failure notification",
  "active": false,
  "nodes": [
    {
      "id": "workflow-failure",
      "name": "Workflow failure",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "notify-failure",
      "name": "Notify failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_FAILURE_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'order_sync.failed', workflow: $json.workflow.name, execution_id: $json.execution.id || null, execution_url: $json.execution.url || null, failed_node: $json.execution.lastNodeExecuted || null }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Workflow failure": {
      "main": [
        [
          {
            "node": "Notify failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
